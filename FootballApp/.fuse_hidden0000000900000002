struct MatchEventsView: View {
    let detail: AFFixtureFull?
    let fixture: AFFixture

    var events: [AFEvent] { detail?.events ?? [] }

    /// Événements triés par minute, filtrés pour une catégorie donnée.
    private func sorted(_ list: [AFEvent]) -> [AFEvent] {
        list.sorted { ($0.time.elapsed, $0.time.extra ?? 0) < ($1.time.elapsed, $1.time.extra ?? 0) }
    }
    var goals: [AFEvent] { sorted(events.filter { $0.isGoal }) }
    var cards: [AFEvent] { sorted(events.filter { $0.isCard }) }
    var subs:  [AFEvent] { sorted(events.filter { $0.isSub }) }

    var body: some View {
        List {
            MatchInfoSection(fixture: fixture)

            if events.isEmpty {
                SwiftUI.Section {
                    EmptyStateView(icon: "list.bullet.rectangle", text: L("match.noEvents"))
                        .listRowBackground(Color.clear)
                }
            } else {
                eventSection(title: L("match.sec.goals"), items: goals)
                eventSection(title: L("match.sec.cards"), items: cards)
                eventSection(title: L("match.sec.subs"),  items: subs)
            }
        }
        .listStyle(.insetGrouped)
    }

    @ViewBuilder
    private func eventSection(title: String, items: [AFEvent]) -> some View {
        if !items.isEmpty {
            SwiftUI.Section {
                ForEach(items) { event in
                    MatchEventRow(event: event, homeTeamId: fixture.teams.home.id)
                        .listRowInsets(EdgeInsets(top: 2, leading: 14, bottom: 2, trailing: 14))
                }
            } header: {
                Text(title)
                    .font(.system(size: 13, weight: .bold))
                    .foregroundColor(Theme.text)
                    .textCase(nil)
            }
        }
    }
}

/// Ruban d'infos du match : date/heure, stade, ville, arbitre.
/// Compact et discret (petit, gris) pour un rendu fluide et pro.
/// NB : API-Football ne fournit NI l'affluence NI la météo → non affichées.
struct MatchInfoSection: View {
    let fixture: AFFixture

    private var dateLine: String? {
        guard let d = fixture.isoDate else { return nil }
        let f = DateFormatter()
        f.locale = Locale.current
        f.dateFormat = "EEE d MMM yyyy · HH:mm"
        f.timeZone = TimeZone.current
        return f.string(from: d).capitalized
    }

    private var venueLine: String? {
        guard let venue = fixture.fixture.venue?.name else { return nil }
        if let city = fixture.fixture.venue?.city { return "\(venue) · \(city)" }
        return venue
    }

    private var refereeLine: String? {
        guard let ref = fixture.fixture.referee, !ref.isEmpty else { return nil }
        return ref
    }

    var body: some View {
        SwiftUI.Section {
            VStack(alignment: .leading, spacing: 7) {
                if let date = dateLine {
                    infoLine(icon: "calendar", text: date)
                }
                if let venue = venueLine {
                    infoLine(icon: "mappin.and.ellipse", text: venue)
                }
                if let ref = refereeLine {
                    infoLine(icon: "flag.checkered", text: ref)
                }
            }
            .padding(.vertical, 4)
            .listRowInsets(EdgeInsets(top: 8, leading: 16, bottom: 8, trailing: 16))
        }
    }

    @ViewBuilder
    private func infoLine(icon: String, text: String) -> some View {
        HStack(spacing: 9) {
            Image(systemName: icon)
                .font(.system(size: 12, weight: .semibold))
                .foregroundColor(.accentColor)
                .frame(width: 16)
            Text(text)
                .font(.system(size: 13, weight: .medium))
                .foregroundColor(Theme.text)
                .lineLimit(1)
            Spacer(minLength: 0)
        }
    }
}

struct MatchEventRow: View {
    let event: AFEvent
    let homeTeamId: Int

    var isHome: Bool { event.team.id == homeTeamId }

    var iconColor: Color {
        if event.isGoal { return .green }
        if event.isCard { return event.detail.contains("Red") ? .red : .yellow }
        if event.isSub  { return .blue }
        return .secondary
    }

    var label: some View {
        VStack(alignment: isHome ? .leading : .trailing, spacing: 0) {
            Text(event.player.name ?? "—")
                .font(.system(size: 13, weight: .semibold))
                .foregroundColor(Theme.text)
                .lineLimit(1)
            if let assist = event.assist?.name, event.isGoal {
                Text("→ \(assist)")
                    .font(.system(size: 11)).foregroundColor(Theme.textSoft)
                    .lineLimit(1)
            } else if event.isSub, let inName = event.assist?.name {
                Text("↔ \(inName)")
                    .font(.system(size: 11)).foregroundColor(Theme.textSoft)
                    .lineLimit(1)
            }
        }
    }

    var icon: some View {
        Image(systemName: event.symbol)
            .font(.system(size: 12))
            .foregroundColor(iconColor)
    }

    var teamLogo: some View {
        TeamLogoView(urlString: event.team.logo, name: event.team.name, size: 17)
    }

    var minute: some View {
        Text(event.minuteLabel)
            .font(.system(size: 12, weight: .bold).monospacedDigit())
            .foregroundColor(Theme.textSoft)
            .frame(width: 34)
    }

    var body: some View {
        HStack(spacing: 7) {
            if isHome {
                minute
                teamLogo
                icon
                label
                Spacer(minLength: 0)
            } else {
                Spacer(minLength: 0)
                label
                icon
                teamLogo
                minute
            }
        }
        .padding(.vertical, 1)
    }
}

