                    .font(.system(size: 9, weight: .heavy))
                    .foregroundColor(.black)
                    .frame(width: 14, height: 14)
                    .background(Color.yellow)
                    .clipShape(Circle())
            }
            if !badges.isEmpty {
                EventBadgesView(badges: badges)
            }
            Spacer()
            if let pos = player.pos {
                Text(pos).font(.caption2).foregroundColor(.secondary)
                    .padding(.horizontal, 6).padding(.vertical, 2)
                    .background(Color(.secondarySystemBackground))
                    .clipShape(Capsule())
            }
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Onglet Statistiques — barres comparatives domicile / extérieur
// ─────────────────────────────────────────────────────────────────────────────
struct MatchStatsView: View {
    let detail: AFFixtureFull?

    var stats: [AFTeamStatistics] { detail?.statistics ?? [] }

    var body: some View {
        if stats.count < 2 {
            EmptyStateView(icon: "chart.bar", text: L("match.noStats"))
        } else {
            let home = stats[0]
            let away = stats[1]
            // On aligne les stats par type (elles arrivent dans le même ordre).
            List {
                SwiftUI.Section {
                    ForEach(Array(home.statistics.enumerated()), id: \.offset) { i, item in
                        let awayItem = i < away.statistics.count ? away.statistics[i] : nil
                        StatComparisonRow(
                            type: item.type,
                            homeValue: item.value?.display ?? "–",
                            awayValue: awayItem?.value?.display ?? "–"
                        )
                        .listRowInsets(EdgeInsets(top: 3, leading: 16, bottom: 3, trailing: 16))
                    }
                } header: {
                    HStack(spacing: 6) {
                        TeamLogoView(urlString: home.team.logo, name: home.team.name, size: 20)
                        Text(home.team.name)
                            .font(.system(size: 13, weight: .bold))
                            .foregroundColor(Theme.text)
                        Spacer()
                        Text(away.team.name)
                            .font(.system(size: 13, weight: .bold))
                            .foregroundColor(Theme.text)
                        TeamLogoView(urlString: away.team.logo, name: away.team.name, size: 20)
                    }
                    .textCase(nil)
                }
            }
            .listStyle(.insetGrouped)
        }
    }
}

struct StatComparisonRow: View {
    let type: String
    let homeValue: String
    let awayValue: String

    var body: some View {
        HStack {
            Text(homeValue)
                .font(.system(size: 13, weight: .bold).monospacedDigit())
                .foregroundColor(Theme.text)
            Spacer()
            Text(type)
                .font(.system(size: 12))
                .foregroundColor(Theme.textSoft)
            Spacer()
            Text(awayValue)
                .font(.system(size: 13, weight: .bold).monospacedDigit())
                .foregroundColor(Theme.text)
        }
        .padding(.vertical, 1)
    }
}
